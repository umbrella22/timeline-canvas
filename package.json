{
  "name": "timeline-canvas-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "pnpm -C packages/timeline build",
    "dev": "pnpm -C packages/timeline dev",
    "lint": "pnpm -C packages/timeline lint",
    "test": "pnpm -C packages/timeline test",
    "test:run": "pnpm -C packages/timeline test:run",
    "test:coverage": "pnpm -C packages/timeline test:coverage",
    "typecheck": "pnpm -C packages/timeline typecheck",
    "postinstall": "node ./scripts/postinstall.mjs",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version && node scripts/postinstall.mjs",
    "changeset:publish": "changeset publish",
    "mcp": "pnpm -C packages/mcp-service start",
    "mcp:typecheck": "pnpm -C packages/mcp-service typecheck",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@rsbuild/plugin-vue": "^1.2.7",
    "@rspress/plugin-preview": "^2.0.9",
    "@rspress/plugin-llms": "2.0.9",
    "@rspress/plugin-sitemap": "^2.0.9",
    "@rspress/plugin-twoslash": "^2.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "@rspress/core": "^2.0.9",
    "rspress-plugin-mermaid": "^1.0.1",
    "tsdown": "^0.21.9",
    "typescript": "^5.9.3",
    "vue": "^3.5.25"
  }
}