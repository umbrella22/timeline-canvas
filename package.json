{
  "name": "timeline-canvas-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -C packages/timeline dev",
    "lint": "vp lint packages docs/public/components scripts rspress.config.ts vite.config.ts",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "typecheck": "pnpm -r --if-present typecheck && pnpm docs:typecheck",
    "docs:typecheck": "tsc -p tsconfig.docs.json",
    "postinstall": "node ./scripts/postinstall.mjs",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version && node scripts/postinstall.mjs",
    "changeset:publish": "changeset publish",
    "mcp": "pnpm -C packages/mcp-service start",
    "mcp:user": "pnpm -C packages/user-mcp-service start",
    "mcp:typecheck": "pnpm -C packages/mcp-service typecheck",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rspress/core": "^2.0.21",
    "@rspress/plugin-llms": "2.0.21",
    "@rspress/plugin-preview": "^2.0.21",
    "@rspress/plugin-sitemap": "^2.0.21",
    "@rspress/plugin-twoslash": "^2.0.21",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rspress-plugin-mermaid": "^1.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vue": "^3.5.42"
  }
}
