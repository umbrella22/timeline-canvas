{
  "name": "timeline-canvas",
  "version": "1.5.0",
  "description": "A powerful timeline component built with Canvas and TypeScript",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch --sourcemap --no-minify",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract-tests.json --noEmit",
    "lint": "vp lint src tests vite.config.ts",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage"
  },
  "keywords": [
    "timeline",
    "canvas",
    "typescript",
    "event-timeline",
    "visual-timeline"
  ],
  "author": "sky <https://github.com/umbrella22>",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^30.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "dependencies": {
    "immer": "^11.1.18"
  },
  "files": [
    "dist",
    "README.md",
    "README_CN.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./builtin-plugin/*": {
      "types": "./dist/builtin-plugin/*.d.mts",
      "import": "./dist/builtin-plugin/*.mjs"
    }
  }
}
