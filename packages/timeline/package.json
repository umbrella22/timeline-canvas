{
  "name": "timeline-canvas",
  "version": "1.4.0",
  "description": "A powerful timeline component built with Canvas and TypeScript",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests vitest.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "timeline",
    "canvas",
    "typescript",
    "event-timeline",
    "visual-timeline"
  ],
  "author": "sky <https://github.com/umbrella22>",
  "license": "MIT",
  "packageManager": "pnpm@10.18.1",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "oxlint": "^1.43.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "immer": "^10.1.1"
  },
  "files": [
    "dist",
    "README.md",
    "README_CN.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./builtin-plugin/*": {
      "types": "./dist/builtin-plugin/*.d.mts",
      "import": "./dist/builtin-plugin/*.mjs"
    }
  }
}
