import type { TimelinePlugin } from "../../plugins/types";
import { PluginType } from "../../plugins/types";

export const {{EXPORT_NAME}}: TimelinePlugin = {
  metadata: {
    name: {{METADATA_NAME_LITERAL}},
    version: {{VERSION_LITERAL}},
    description: {{DESCRIPTION_LITERAL}},
    type: PluginType.RENDER,
  },
  activate(context) {
    context.api.registerRenderLayer({
      name: {{RENDER_LAYER_NAME_LITERAL}},
      position: "overlay", // 'background' | 'overlay'
      render: (ctx, _canvas, _config, _state) => {
        // ctx 来自对应 buffer 的 OffscreenCanvasRenderingContext2D
        // 不要缓存 ctx 引用，每次 render 调用的 ctx 可能不同
        ctx.save();
        // TODO: implement custom rendering
        ctx.restore();
      },
    });
  },
  deactivate(context) {
    context.api.unregisterRenderLayer({{RENDER_LAYER_NAME_LITERAL}});
  },
};
